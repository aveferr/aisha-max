# Скопируйте в .env и заполните: cp .env.example .env

# --- База данных ---
POSTGRES_USER=afisha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=afisha

# --- MAX ---
# Токен чат-бота выдают организаторы хакатона / платформа MAX. Не коммитьте .env в репозиторий!
MAX_BOT_TOKEN=
# Имя бота (без @): нужно для ссылок-приглашений на голосование и открытия мини-приложения
MAX_BOT_USERNAME=
# Если MAX API требует корневой сертификат Минцифры: положите PEM в ./certs и укажите путь внутри контейнера
# MAX_CA_BUNDLE=/certs/russian_trusted_root_ca.pem

# --- API ---
API_PORT=8000
WEB_PORT=8080
# Адрес(а) мини-приложения через запятую, например https://my-miniapp.example.com. «*» — только для разработки.
CORS_ORIGINS=*
# true — разрешает заголовок X-Dev-User-Id вместо подписанного initData. ТОЛЬКО для локальной разработки.
DEV_AUTH_ENABLED=true
# Токен для GET /api/v1/admin/metrics (метрики пилота). Пусто — эндпоинт отключён.
ADMIN_TOKEN=

# --- Боевой сервер (docker-compose.prod.yml) ---
# Адрес сайта без https://. Без своего домена подойдёт IP через sslip.io:
# для сервера 203.0.113.10 это 203-0-113-10.sslip.io
DOMAIN=

# --- Данные ---
TIMEZONE=Europe/Moscow
DEFAULT_CITY=Санкт-Петербург
# Загружать демонстрационные события (помечены как тестовые данные)
SEED_DEMO_DATA=true

# --- LLM (необязательно) ---
# Любой OpenAI-совместимый сервер. Для Ollama на этом же компьютере (Docker Desktop):
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen2.5:3b
# Пусто — бот понимает реплики по правилам, без нейросети.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Ответ на процессоре бывает медленным, особенно первый запрос (загрузка модели в память)
LLM_TIMEOUT_SECONDS=60
